version: "3.9"

services:
  always-https:
    image: docker.sunet.se/always-https:latest
    restart: always
    ports:
      - "80:80"
    environment:
      - ACME_URL=http://acme-c.sunet.se/

  # Trust anchor service using go-trust repository
  go-trust:
    image: docker.sunet.se/docker-go-trust:<%= @trust_tag || "latest" %>
    user: "0:0"
    restart: always
    ports:
      - "443:6001"
    volumes:
      - /etc/dehydrated/private/trust-dev-1.iam.sunet.se.pem:/tls_cert.pem:ro
      - /etc/dehydrated/private/trust-dev-1.iam.sunet.se.key:/tls_key.pem:ro
    depends_on:
      - always-https

  # MS Registry service
  ms-registry:
    image: docker.sunet.se/docker-ms-registry:<%= @ms_registry_tag || "latest" %>
    restart: always
    ports:
      - "8000:8000"
      - "8443:8443"
      - "3030:3030"
    environment:
      - ENV=<%= @env %>
      - SECRET_KEY=<%= @secret_key %>
      - DEBUG=<%= @debug %>
      - DB_PASSWORD=<%= @db_password %>
      - DATABASE_URL=postgresql://postgres:<%= @db_password %>@db:5432/ms_registry
      - REDIS_URL=<%= @redis_url %>
    depends_on:
      - db
      - redis
      - always-https
    volumes:
      - /etc/dehydrated/private/trust-dev-1.iam.sunet.se.pem:/tls_cert.pem:ro
      - /etc/dehydrated/private/trust-dev-1.iam.sunet.se.key:/tls_key.pem:ro
      - static_data:/var/www/static
      - media_data:/var/www/media

  # PostgreSQL database for MS Registry
  db:
    image: postgres:14
    restart: always
    environment:
      - POSTGRES_DB=ms_registry
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=<%= @db_password %>
    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:6.2
    restart: always

networks:
  default:
    driver_opts:
      com.docker.network.bridge.name: br-trust

volumes:
  postgres_data:
  static_data:
  media_data:
