version: "3.8"

services:
  docker-ms-registry:
    image: docker.sunet.se/docker-ms-registry:<%= @ms_registry_tag || "latest" %>
    restart: always
    ports:
      - "8000:8000"
      - "3030:3030"
    environment:
      - ENV=<%= @env %>
      - SECRET_KEY=<%= @secret_key %>
      - DEBUG=<%= @debug %>
      - DB_PASSWORD=<%= @db_password %>
      - DATABASE_URL=postgresql://postgres:<%= @db_password %>@db:5432/ms_registry
      - REDIS_URL=<%= @redis_url %>
    depends_on:
      - db
      - redis
    volumes:
      - static_data:/var/www/static
      - media_data:/var/www/media

  db:
    image: postgres:14
    restart: always
    environment:
      - POSTGRES_DB=ms_registry
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=<%= @db_password %>
    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:6.2
    restart: always

networks:
  default:
    driver_opts:
      com.docker.network.bridge.name: br-ms-registry

volumes:
  postgres_data:
  static_data:
  media_data:
