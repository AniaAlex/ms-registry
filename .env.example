# Environment configuration for ms-registry
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# ──────────────────────────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────────────────────────
ENV=LOCAL
DEBUG=True

# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=ms_registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecret

# ──────────────────────────────────────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production

# ──────────────────────────────────────────────────────────────────────────────
# Registry Signing Key (for JWT/LoTE signing)
# Generate with: python manage.py generate_registry_signing_key
# ──────────────────────────────────────────────────────────────────────────────
REGISTRY_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\nYOUR_EC_P256_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────────────────────────────────────
# Access CA configuration (django-ca)
# ──────────────────────────────────────────────────────────────────────────────
# Hex serial of the CA (set after running `make init-ca`)
# Leave empty initially - the integration code will find the first usable CA
# Example: CA_DEFAULT_CA=1A2B3C4D5E6F
CA_DEFAULT_CA=

# Default certificate subject attributes
CA_COUNTRY=SE
CA_ORGANIZATION=EUDI Wallet Registry

# Certificate Practice Statement (CPS) URL - included in issued certificates
# CA_CPS_URI=https://registry.eudi-wallet.se/cps

# Hostname (no scheme) used for OCSP/CRL/CA Issuer URLs in issued certificates
# CA_HOSTNAME=ca.eudi-wallet.se
